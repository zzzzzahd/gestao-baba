# ═══════════════════════════════════════════════════════════════
# Draft Play — Variáveis de ambiente
# ═══════════════════════════════════════════════════════════════
# Como configurar (modo fácil):
#   1. Copie este arquivo:  cp .env.example .env
#      (Windows PowerShell): Copy-Item .env.example .env
#   2. Preencha os valores abaixo com os dados do seu projeto Supabase
#   3. Rode: npm run dev
#
# Onde achar as chaves:
#   Supabase → Project Settings → API
#   - Project URL  → VITE_SUPABASE_URL
#   - anon / public key → VITE_SUPABASE_PUBLISHABLE_KEY
# ═══════════════════════════════════════════════════════════════

# Obrigatórias (o app não sobe sem elas)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sua-chave-anon-publica

# Opcionais
# Chave pública VAPID para notificações push (Supabase → Edge Functions / Web Push)
VITE_VAPID_PUBLIC_KEY=

# Sentry (monitoramento de erros) — deixe vazio em desenvolvimento local
VITE_SENTRY_DSN=

# Token do Sentry só no CI/deploy (nunca no frontend)
# SENTRY_AUTH_TOKEN=

# Google AdSense — Fase 1 (monetização). Deixe vazio até a conta ser aprovada
# (adsense.google.com); o AdBanner e o script no index.html ficam inativos
# automaticamente enquanto estiver vazio. Formato: ca-pub-XXXXXXXXXXXXXXXX
VITE_ADSENSE_CLIENT_ID=
# IDs de slot das 3 unidades de anúncio (criadas no painel do AdSense após aprovação)
# Só nessas 3 páginas públicas — nunca no dashboard/área autenticada (ver AdsenseScriptGate.jsx)
VITE_ADSENSE_SLOT_LANDING=
VITE_ADSENSE_SLOT_ABOUT=
VITE_ADSENSE_SLOT_PUBLIC_PROFILE=
# Anúncio recompensado OPCIONAL para baixar a imagem dos times (/ferramentas/sorteador).
# Deixe vazio/false até a aprovação do AdSense. Com "true", o download da imagem exige
# assistir a um anúncio; copiar o texto continua livre. Não afeta nenhuma outra página.
VITE_TOOLS_REWARDED_EXPORT=
