# ═══════════════════════════════════════════════════════════════
# Draft Play — Variáveis de ambiente
# ═══════════════════════════════════════════════════════════════
# Como configurar:
#   1. Copie este arquivo:  cp .env.example .env
#      (Windows PowerShell): Copy-Item .env.example .env
#   2. Preencha os valores com os dados do seu projeto Supabase / serviços
#   3. Rode: npm run dev
#
# NUNCA commite o arquivo .env com valores reais.
# Variáveis VITE_* ficam disponíveis no navegador — não coloque secrets.
#
# Onde achar as chaves Supabase:
#   Supabase → Project Settings → API
#   - Project URL        → VITE_SUPABASE_URL
#   - anon / public key  → VITE_SUPABASE_PUBLISHABLE_KEY
# ═══════════════════════════════════════════════════════════════

# ── Obrigatórias (frontend) ───────────────────────────────────
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sua-chave-anon-publica

# ── Opcionais (frontend) ──────────────────────────────────────
# Web Push (chave pública VAPID)
VITE_VAPID_PUBLIC_KEY=

# Sentry (DSN público do projeto) — deixe vazio em desenvolvimento local
VITE_SENTRY_DSN=

# Cloudflare Turnstile (site key pública; a SECRET fica só no Supabase Auth)
VITE_TURNSTILE_SITE_KEY=

# PostHog (analytics) — deixe vazio para desativar
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://app.posthog.com

# Google AdSense — deixe vazio até a conta ser aprovada
# Formato do client: ca-pub-XXXXXXXXXXXXXXXX
VITE_ADSENSE_CLIENT_ID=
VITE_ADSENSE_SLOT_HOME=
VITE_ADSENSE_SLOT_DASHBOARD=
VITE_ADSENSE_SLOT_PROFILE=
VITE_ADSENSE_SLOT_LANDING=
VITE_ADSENSE_SLOT_ABOUT=
VITE_ADSENSE_SLOT_PUBLIC_PROFILE=

# ── Somente CI / build (NÃO use no frontend) ──────────────────
# Token do Sentry para upload de sourcemaps no build/CI
# SENTRY_AUTH_TOKEN=

# ── Somente scripts locais / E2E / video-demo (NÃO versionar valores) ──
# Conta de demo/teste para Playwright e video-demo
# DEMO_EMAIL=
# DEMO_PASSWORD=
# TEST_EMAIL=
# TEST_PASSWORD=
# BASE_URL=http://localhost:3000
# DEMO_SPEED=normal
# VIDEO_FORMAT=vertical
# DEMO_FOLLOW_USER_ID=

# Service Role — NUNCA no frontend, NUNCA no Git, só em scripts locais/CI privilegiado
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
